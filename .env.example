# ========================================================
# Configurações do rdgen (RustDesk Client Generator)
# ========================================================

# Usuário e repositório no GitHub (onde foi feito o fork)
GHUSER=SamuelSilvaG
REPONAME=rdgen
GHBRANCH=master

# Token do GitHub (Fine-Grained PAT com permissões de Actions e Workflows: Read & Write)
# Gere em: https://github.com/settings/personal-access-tokens/new
GHBEARER=insira_seu_token_aqui

# URL pública onde este servidor rdgen estará acessível para o GitHub Actions
# (ex: https://rdgen.seudominio.com ou URL do ngrok / Cloudflare Tunnel)
# IMPORTANTE: Deve ser EXATAMENTE o mesmo valor configurado no secret GENURL do GitHub!
GENURL=http://localhost:8000

# Senha para criptografar os dados transitados para a build do GitHub Actions
# IMPORTANTE: Deve ser EXATAMENTE o mesmo valor configurado no secret ZIP_PASSWORD do GitHub!
ZIP_PASSWORD=coloque_uma_senha_forte_aqui

# Chave secreta do Django
SECRET_KEY=sua_secret_key_django_aqui

# Protocolo (https ou http)
PROTOCOL=https

# Modo de depuração (False em produção)
DEBUG=False
